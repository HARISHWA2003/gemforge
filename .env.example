OPENAI_API_KEY=your_api_key_here
# Image editing model (verified against developers.openai.com/api/docs/models, 2026-09-30)
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# Vision model used once per batch to classify Front/Back/Side and background
OPENAI_VISION_MODEL=gpt-6-astra
# Size requested from the API (must be multiples of 16); Python rescales uniformly to 1080x1080
OPENAI_IMAGE_SIZE=1088x1088
# low | medium | high | xhigh | max | auto
OPENAI_IMAGE_QUALITY=high
OPENAI_TIMEOUT=300
MAX_RETRIES=3
INPUT_DIR=./input
OUTPUT_DIR=./output
FAILED_DIR=./failed
LOG_DIR=./logs
